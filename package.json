{
  "name": "crochet-field-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static beginner crochet course with optional WebMCP tools.",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "preview": "python3 -m http.server 8000",
    "test": "node tests/test-smoke.cjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.159.0"
  }
}
